<!DOCTYPE html>

<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>INTRANET</title>

    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/fullcalendar.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-2vMryTPZxTZDZ3GnMBDVQV8OtmoutdrfJxnDTg0bVam9mZhi7Zr3J1+lkVFRr71f" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/Content/css/bg.css" />
    <link rel="stylesheet" href="~/Content/css/calendar.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />

</head>

<!-- Modal de Aviso de Mudança de Endereço -->
<style>
    #modalMudancaEndereco .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    #modalMudancaEndereco .modal-header {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border-bottom: none;
        padding: 1.5rem 1.5rem 1rem;
    }

    #modalMudancaEndereco .modal-title {
        font-weight: 600;
        font-size: 1.1rem;
    }

    #modalMudancaEndereco .icon-container {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

        #modalMudancaEndereco .icon-container i {
            font-size: 2.5rem;
            color: #1e40af;
        }

    #modalMudancaEndereco .address-card {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1rem;
        margin: 1rem 0;
    }

    #modalMudancaEndereco .address-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        border-radius: 8px;
    }

    #modalMudancaEndereco .address-old {
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    #modalMudancaEndereco .address-new {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    #modalMudancaEndereco .address-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        min-width: 50px;
    }

    #modalMudancaEndereco .address-url {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.85rem;
        color: #334155;
    }

    #modalMudancaEndereco .address-old .address-url {
        text-decoration: line-through;
        color: #94a3b8;
    }

    #modalMudancaEndereco .arrow-divider {
        text-align: center;
        padding: 0.5rem 0;
    }

        #modalMudancaEndereco .arrow-divider i {
            color: #3b82f6;
            font-size: 1.25rem;
        }

    #modalMudancaEndereco .info-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 0.875rem;
        margin-top: 1rem;
    }

        #modalMudancaEndereco .info-box i {
            color: #d97706;
        }

        #modalMudancaEndereco .info-box p {
            margin: 0;
            font-size: 0.875rem;
            color: #92400e;
        }

    #modalMudancaEndereco .tip-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.5rem 0;
        font-size: 0.875rem;
        color: #475569;
    }

        #modalMudancaEndereco .tip-item i {
            color: #3b82f6;
            margin-top: 2px;
        }

    #modalMudancaEndereco .modal-footer {
        border-top: 1px solid #e2e8f0;
        padding: 1rem 1.5rem;
        background: #f8fafc;
    }

    #modalMudancaEndereco .btn-understood {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
        border: none;
        padding: 0.625rem 1.5rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        #modalMudancaEndereco .btn-understood:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

    #modalMudancaEndereco .sics-logo {
        font-family: 'Iceland';
        font-size: 1.5rem;
    }
</style>



<body>

    @*BACKGROUND ANIMADO*@
    <div class="bg"></div>
    <div class="bg bg2"></div>
    <div class="bg bg3"></div>


    @*NAVBAR*@
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark custom_nav-container w-100 fw-medium text-uppercase">
        <div class="container-fluid">

            <!-- Logo -->
            <a class="navbar-brand" href="#home">
                <img class="rounded-1" src="~/Content/img/softHairBranca.png" alt="Logo soft">
            </a>

            <a class="navbar-brand" href="#home">
                <div class="contador-copa">
                    <h6>Copa do Mundo 2026</h6>

                    <div id="contador">
                        <span id="dias">00</span>d
                        <span id="horas">00</span>h
                        <span id="minutos">00</span>min
                        <span id="segundos">00</span>s
                    </div>
                </div>

                <script>
                    // Abertura: 11/06/2026 às 13:00 no México
                    // Equivale a 16:00 no horário de Brasília
                    const dataAbertura = new Date("2026-06-11T16:00:00-03:00").getTime();

                    const intervalo = setInterval(function () {
                        const agora = new Date().getTime();
                        const distancia = dataAbertura - agora;

                        if (distancia <= 0) {
                            clearInterval(intervalo);
                            document.getElementById("contador").innerHTML = "A Copa começou!";
                            return;
                        }

                        const dias = Math.floor(distancia / (1000 * 60 * 60 * 24));
                        const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
                        const segundos = Math.floor((distancia % (1000 * 60)) / 1000);

                        document.getElementById("dias").innerText = dias;
                        document.getElementById("horas").innerText = horas.toString().padStart(2, "0");
                        document.getElementById("minutos").innerText = minutos.toString().padStart(2, "0");
                        document.getElementById("segundos").innerText = segundos.toString().padStart(2, "0");
                    }, 1000);
                </script>
            </a>
                <!-- Botão mobile -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                        <!-- Home -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#home"
                               id="homeDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                inicio
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="homeDropdown">
                                <li><a class="dropdown-item" href="#avisos">Avisos</a></li>
                                <li><a class="dropdown-item" href="#aniversariantes">Aniversariantes</a></li>
                                <li><a class="dropdown-item" href="#calendar">Calendário</a></li>
                            </ul>
                        </li>

                        <!-- Institucional -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#"
                               id="instDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Institucional
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="instDropdown">
                                <li><a class="dropdown-item" href="#ginastica">Ginástica</a></li>
                                <li><a class="dropdown-item" href="#regras">Regras</a></li>
                                <li><a class="dropdown-item" href="#horario">Refeição</a></li>
                            </ul>
                        </li>

                        <!-- Links diretos -->
                        <li class="nav-item">
                            <a class="nav-link" href="#lancamentos">Lançamentos</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#"
                               id="instDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Sistemas
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="instDropdown">
                                <li><a class="dropdown-item" href="http://192.168.0.200/relatorios/">Relatorios</a></li>
                                <li><a class="dropdown-item" href="http://192.168.0.203/sics/AgendamentoReuniao/" target="_blank">Agendamentos</a></li>
                                <li><a class="dropdown-item" href="http://192.168.0.203/sics/">SICS</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#ramais">Ramais</a>
                        </li>

                        @*<li class="nav-item">
                        <a class="nav-link" href="#solicitacoes">Solicitações</a>
                    </li>*@
                    </ul>
                </div>
        </div>
    </nav>

    @*======================================================== INICIO MODAL TEMPORARIO =================================================================*@

    <div class="modal fade" id="modalMudancaEndereco" tabindex="-1" aria-labelledby="modalMudancaEnderecoLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalMudancaEnderecoLabel">
                        <i class="bi bi-megaphone-fill me-2"></i>Atenção: Novo Endereço de Acesso
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body px-4 py-4">

                    <div class="text-center">
                        <span class="fs-1" style="font-family: Iceland">SICS</span>
                    </div>

                    <div class="text-center mb-3">
                        <h6 class="text-danger mb-2" style="font-size: 1.1rem; color: #1e293b;">
                            O endereço de acesso ao <span class="sics-logo">SICS</span> na matriz mudou!
                        </h6>
                        <p class="text-muted mb-0" style="font-size: 0.9rem;">
                            Se você acessa via computador ou tablet na <strong>matriz</strong>, atualize seu acesso.
                        </p>
                    </div>

                    <div class="address-card">
                        <div class="address-item address-old">
                            <span class="address-label text-danger">Antigo</span>
                            <span class="address-url">http://192.168.0.200/sics</span>
                        </div>

                        <div class="arrow-divider">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                        </div>

                        <div class="address-item address-new">
                            <span class="address-label text-success">Novo</span>
                            <span class="address-url fw-semibold">http://192.168.0.203/sics</span>
                        </div>
                    </div>

                    <div class="info-box d-flex align-items-start gap-2">
                        <i class="bi bi-building-fill mt-1"></i>
                        <p><strong>Filiais:</strong> Nenhuma alteração necessária. Continue acessando normalmente.</p>
                    </div>

                    <div class="mt-3 pt-2">
                        <p class="fw-semibold mb-2" style="font-size: 0.875rem; color: #334155;">
                            <i class="bi bi-lightbulb-fill text-warning me-1"></i> Dicas:
                        </p>
                        <div class="tip-item">
                            <i class="bi bi-bookmark-star-fill"></i>
                            <span>Atualize seus favoritos e atalhos com o novo endereço.</span>
                        </div>
                        <div class="tip-item">
                            <i class="bi bi-grid-fill"></i>
                            <span>Acesse também pelo menu <strong>"SISTEMAS"</strong> no canto superior direito deste portal.</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer flex-column">
                    <button type="button" class="btn btn-primary btn-understood w-100" data-bs-dismiss="modal">
                        <i class="bi bi-check2-circle me-2"></i>Entendi
                    </button>
                    <small class=" mt-2 text-danger">
                        <i class="bi bi-headset me-1"></i>Precisa de ajuda? Solicite suporte ao Fagner ou Luiz.
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Script para abrir o modal automaticamente -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('modalMudancaEndereco'));
            modal.show();
        });
    </script>
    @*======================================================== FINAL MODAL TEMPORARIO =================================================================*@

    @RenderBody()
    @*FOOTER*@
    <footer>
        <div class="row g-4 m-0 p-0 bg-black">
            <div class="col-md-4 text-center text-white pt-5">
                <h5>Lojasofthair.com.br</h5>
            </div>
            <div class="col-md-4 footer-col text-center pt-4">
                <img src="~/Content/img/softHairBranca.png" alt="" style="width: 125px; height: auto;">
                <hr style="background-color: rgb(139, 137, 137);">
                <p class="text-white-50" style="color: #ccc;">Siga-nos nas redes sociais</p>
                <p class="fab fa-facebook-f" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-instagram" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-linkedin-in" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
            </div>
            <div class="col-md-4 footer-col text-center text-white pt-5">
                <h5>Softhair.com.br</h5>
            </div>
            <div class="pb-3 d-flex justify-content-between">
                <div class="text-white-50 pb-4">Intranet - Softhair - Por: Arthur Reis</div>
                <div class="text-white-50 pb-4">Em caso de qualquer dúvidas: Procure o setor de <strong>TI</strong></div>
            </div>
        </div>
    </footer>

    @*LINK DOS SCRIPTS JS*@
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>

    <script src="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.js" integrity="sha384-2Ul6oqy3mEjM7dBJzKOck1Qb/mzlO+k/0BQv3D3C7u+Ri9+7OBINGa24AeOv5rgu" crossorigin="anonymous"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

    <script src="~/Scripts/JavaScript/calendar.js"></script>
    <script src="~/Scripts/JavaScript/datables.js"></script>
    <script src="~/Scripts/JavaScript/script.js"></script>
</body>
</html>