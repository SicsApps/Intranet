<!DOCTYPE html>

<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>INTRANET</title>

    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/fullcalendar.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-2vMryTPZxTZDZ3GnMBDVQV8OtmoutdrfJxnDTg0bVam9mZhi7Zr3J1+lkVFRr71f" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/Content/css/bg.css" />
    <link rel="stylesheet" href="~/Content/css/calendar.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />

</head>




<body>

    @*BACKGROUND ANIMADO*@
    <div class="bg"></div>
    <div class="bg bg2"></div>
    <div class="bg bg3"></div>


    @*NAVBAR*@
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark custom_nav-container w-100 fw-medium text-uppercase">
        <div class="container-fluid">

            <!-- Logo -->
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img class="rounded-1" src="~/Content/img/softHairBranca.png" alt="Logo soft">
            </a>

            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <div class="contador-copa">
                    <h6>Copa do Mundo 2026</h6>

                    <div id="contador">
                        <div class="text-center">
                            <span id="dias">00</span>d
                            <span id="horas">00</span>h
                            <span id="minutos">00</span>min
                            <span id="segundos">00</span>s
                        </div>
                    </div>
                </div>

                <script>
                    // Abertura: 11/06/2026 às 13:00 no México
                    // Equivale a 16:00 no horário de Brasília
                    const dataAbertura = new Date("2026-06-11T16:00:00-03:00").getTime();

                    const intervalo = setInterval(function () {
                        const agora = new Date().getTime();
                        const distancia = dataAbertura - agora;

                        if (distancia <= 0) {
                            clearInterval(intervalo);
                            document.getElementById("contador").innerHTML = "A Copa começou!";
                            return;
                        }

                        const dias = Math.floor(distancia / (1000 * 60 * 60 * 24));
                        const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
                        const segundos = Math.floor((distancia % (1000 * 60)) / 1000);

                        document.getElementById("dias").innerText = dias;
                        document.getElementById("horas").innerText = horas.toString().padStart(2, "0");
                        document.getElementById("minutos").innerText = minutos.toString().padStart(2, "0");
                        document.getElementById("segundos").innerText = segundos.toString().padStart(2, "0");
                    }, 1000);
                </script>
            </a>
            <!-- Botão mobile -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <!-- Home -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="@Url.Action("Index", "Home")"
                           id="homeDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            inicio
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="homeDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#avisos">Avisos</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#aniversariantes">Aniversariantes</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#calendar">Calendário</a></li>
                        </ul>
                    </li>

                    <!-- Terminal consulta -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "PerguntaProdutos")#lancamentos">Terminal</a>
                    </li>

                    <!-- Institucional -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#"
                           id="instDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Institucional
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="instDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#ginastica">Ginástica</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#regras">Regras</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")#horario">Refeição</a></li>
                        </ul>
                    </li>

                    <!-- Links diretos -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#lancamentos">Lançamentos</a>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#"
                           id="instDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Sistemas
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="instDropdown">
                            <li><a class="dropdown-item" href="http://192.168.0.200/relatorios/">Relatorios</a></li>
                            <li><a class="dropdown-item" href="http://192.168.0.203/sics/AgendamentoReuniao/" target="_blank">Agendamentos</a></li>
                            <li><a class="dropdown-item" href="http://192.168.0.203/sics/">SICS</a></li>
                            @*<li><a class="dropdown-item" href="@Url.Action("Index", "PerguntaProdutos")">Perguntas sobre produtos</a></li>*@
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")#ramais">Ramais</a>
                    </li>

                    @*<li class="nav-item">
            <a class="nav-link" href="#solicitacoes">Solicitações</a>
        </li>*@
                </ul>
            </div>
        </div>
    </nav>


    @RenderBody()
    @*FOOTER*@
    <footer>
        <div class="row g-4 m-0 p-0 bg-black">
            <div class="col-md-4 text-center text-white pt-5">
                <h5>Lojasofthair.com.br</h5>
            </div>
            <div class="col-md-4 footer-col text-center pt-4">
                <img src="~/Content/img/softHairBranca.png" alt="" style="width: 125px; height: auto;">
                <hr style="background-color: rgb(139, 137, 137);">
                <p class="text-white-50" style="color: #ccc;">Siga-nos nas redes sociais</p>
                <p class="fab fa-facebook-f" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-instagram" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-linkedin-in" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
            </div>
            <div class="col-md-4 footer-col text-center text-white pt-5">
                <h5>Softhair.com.br</h5>
            </div>
            <div class="pb-3 d-flex justify-content-between">
                <div class="text-white-50 pb-4">Intranet - Softhair - Por: Pedro Ivo</div>
                <div class="text-white-50 pb-4">Em caso de qualquer dúvidas: Procure o setor de <strong>TI</strong></div>
            </div>
        </div>
    </footer>

    @*LINK DOS SCRIPTS JS*@
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>

    <script src="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.js" integrity="sha384-2Ul6oqy3mEjM7dBJzKOck1Qb/mzlO+k/0BQv3D3C7u+Ri9+7OBINGa24AeOv5rgu" crossorigin="anonymous"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

    @if (ViewContext.RouteData.Values["controller"].ToString() == "Home")
    {
        <script src="~/Scripts/JavaScript/calendar.js"></script>
        <script src="~/Scripts/JavaScript/datables.js"></script>
    }
    <script src="~/Scripts/JavaScript/script.js"></script>
</body>
</html>
