<!DOCTYPE html>

<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>INTRANET</title>

    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/fullcalendar.min.css" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.css" rel="stylesheet" integrity="sha384-2vMryTPZxTZDZ3GnMBDVQV8OtmoutdrfJxnDTg0bVam9mZhi7Zr3J1+lkVFRr71f" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/Content/css/bg.css" />
    <link rel="stylesheet" href="~/Content/css/calendar.css" />
    <link rel="stylesheet" href="~/Content/css/style.css" />

</head>

<body>

    @*BACKGROUND ANIMADO*@
    <div class="bg"></div>
    <div class="bg bg2"></div>
    <div class="bg bg3"></div>


    @*NAVBAR*@
    <nav class="small navbar navbar-expand-lg navbar-dark bg-dark custom_nav-container w-100 fw-medium text-uppercase">
        <div class="container-fluid">

            <!-- Logo -->
            <a class="navbar-brand" href="#home">
                <img class="rounded-1" src="~/Content/img/softHairBranca.png" alt="Logo soft">
            </a>

            <div id="mySics" class="toast position-fixed bottom-0 end-0 m-3"
                 role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">

                <div class="toast-header">
                    <img src="http://192.168.0.200/sics/Content/images/SICS%20ICELAND.png"
                         class="me-auto" alt="SICS" style="width:100px;">
                    <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                </div>

                <div class="toast-body bg-black">
                    <a class="btn btn-outline-light btn-lg p-3 w-100" href="http://192.168.0.200/sics/" target="_blank">
                        Acessar SICS
                    </a>
                </div>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const toastEl = document.getElementById('mySics');
                    const toast = new bootstrap.Toast(toastEl
                    );
                    toast.show();
                });
            </script>



            <!-- Botão mobile -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <!-- Home -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#home"
                           id="homeDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            inicio
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="homeDropdown">
                            <li><a class="dropdown-item" href="#avisos">Avisos</a></li>
                            <li><a class="dropdown-item" href="#aniversariantes">Aniversariantes</a></li>
                            <li><a class="dropdown-item" href="#calendar">Calendário</a></li>
                        </ul>
                    </li>

                    <!-- Institucional -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#"
                           id="instDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            Institucional
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="instDropdown">
                            <li><a class="dropdown-item" href="#ginastica">Ginástica</a></li>
                            <li><a class="dropdown-item" href="#regras">Regras</a></li>
                            <li><a class="dropdown-item" href="#horario">Refeição</a></li>
                        </ul>
                    </li>

                    <!-- Links diretos -->
                    <li class="nav-item">
                        <a class="nav-link" href="#lancamentos">Lançamentos</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#ramais">Ramais</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="http://192.168.0.200/relatorios/">Relatorios</a>
                    </li>

                    <!-- Agendamentos -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="http://192.168.0.200/sics/AgendamentoReuniao/"
                           target="_blank">
                            Agendamentos
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>


    @RenderBody()
    @*FOOTER*@
    <footer>
        <div class="row g-4 m-0 p-0 bg-black">
            <div class="col-md-4 text-center text-white pt-5">
                <h5>Lojasofthair.com.br</h5>
            </div>
            <div class="col-md-4 footer-col text-center pt-4">
                <img src="~/Content/img/softHairBranca.png" alt="" style="width: 125px; height: auto;">
                <hr style="background-color: rgb(139, 137, 137);">
                <p class="text-white-50" style="color: #ccc;">Siga-nos nas redes sociais</p>
                <p class="fab fa-facebook-f" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-instagram" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
                <p class="fab fa-linkedin-in" style="color: #ccc; margin: 0 10px; font-size: 23px;"></p>
            </div>
            <div class="col-md-4 footer-col text-center text-white pt-5">
                <h5>Softhair.com.br</h5>
            </div>
            <div class="pb-3 d-flex justify-content-between">
                <div class="text-white-50 pb-4">Intranet - Softhair - Por: Arthur Reis</div>
                <div class="text-white-50 pb-4">Em caso de qualquer dúvidas: Procure o setor de <strong>TI</strong></div>
            </div>
        </div>
    </footer>

    @*LINK DOS SCRIPTS JS*@
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>

    <script src="https://cdn.datatables.net/v/dt/dt-2.2.2/datatables.min.js" integrity="sha384-2Ul6oqy3mEjM7dBJzKOck1Qb/mzlO+k/0BQv3D3C7u+Ri9+7OBINGa24AeOv5rgu" crossorigin="anonymous"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>

    <script src="~/Scripts/JavaScript/calendar.js"></script>
    <script src="~/Scripts/JavaScript/datables.js"></script>
    <script src="~/Scripts/JavaScript/script.js"></script>
</body>
</html>